{
  "version": "2.0",
  "envId": "{{env.TCB_ENV_ID}}",
  "$schema": "https://framework-1258016615.tcloudbaseapp.com/schema/latest.json",
  "functionRoot": "cloudfunctions",
  "functions": [
    {
      "name": "api",
      "timeout": 30,
      "runtime": "Nodejs20.19",
      "memorySize": 256,
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "ANON_ALIAS_SECRET": "{{env.ANON_ALIAS_SECRET}}",
        "NODE_ENV": "production",
        "CLOUDBASE_APIKEY": "{{env.CLOUDBASE_APIKEY}}",
        "MINIPROGRAM_APP_ID": "{{env.MINIPROGRAM_APP_ID}}"
      }
    },
    {
      "name": "worker",
      "timeout": 60,
      "runtime": "Nodejs20.19",
      "memorySize": 512,
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "ANON_ALIAS_SECRET": "{{env.ANON_ALIAS_SECRET}}",
        "NODE_ENV": "production",
        "CLOUDBASE_APIKEY": "{{env.CLOUDBASE_APIKEY}}",
        "MINIPROGRAM_APP_ID": "{{env.MINIPROGRAM_APP_ID}}"
      },
      "triggers": [
        {
          "name": "blacklight-review-minute",
          "type": "timer",
          "config": "0 */1 * * * * *"
        }
      ]
    },
    {
      "name": "review-callback",
      "timeout": 20,
      "runtime": "Nodejs20.19",
      "memorySize": 256,
      "handler": "index.main",
      "installDependency": true,
      "envVariables": {
        "REVIEW_CALLBACK_SECRET": "{{env.REVIEW_CALLBACK_SECRET}}",
        "NODE_ENV": "production",
        "CLOUDBASE_APIKEY": "{{env.CLOUDBASE_APIKEY}}",
        "MINIPROGRAM_APP_ID": "{{env.MINIPROGRAM_APP_ID}}"
      }
    }
  ]
}
