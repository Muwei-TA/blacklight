# Copy this file to /vol1/docker/blacklight-nas-gitea-ci/.env on the NAS.
# Set MINIPROGRAM_APP_ID to the app identifier approved for this isolated stack.
# Keep all credentials in the sibling secrets/ directory; never add them here.
NAS_DATA_ROOT=/vol1/docker/blacklight-nas-gitea-ci
NAS_BACKUP_ROOT=/vol2/backups/blacklight-nas-gitea-ci
NAS_COMPOSE_PROJECT_NAME=blacklight-nas-gitea-ci
NAS_NETWORK_PREFIX=blacklight-nas-gitea-ci
NAS_PG_IMAGE=blacklight-nas-gitea-ci-postgres:16
NAS_APP_IMAGE=blacklight-nas-gitea-ci-api:bootstrap
NAS_LAN_MODE=1
API_BIND_IP=192.168.50.28
API_BIND_PORT=18119
PUBLIC_API_BASE_URL=http://192.168.50.28:18119
MINIPROGRAM_APP_ID=replace-with-approved-miniprogram-app-id
POSTGRES_DB=blacklight
POSTGRES_ADMIN_USER=blacklight_admin
