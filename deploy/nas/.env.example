# Copy to /vol1/docker/blacklight-nas-data/.env on the NAS. This file contains configuration only;
# keep all credentials in the sibling secrets/ directory.
NAS_DATA_ROOT=/vol1/docker/blacklight-nas-data
NAS_BACKUP_ROOT=/vol2/backups/blacklight-nas-data
NAS_COMPOSE_PROJECT_NAME=blacklight-nas-data
NAS_NETWORK_PREFIX=blacklight-nas
NAS_PG_IMAGE=blacklight-nas-postgres:16
NAS_APP_IMAGE=blacklight-nas-api:local
NAS_LAN_MODE=1
API_BIND_IP=192.168.50.28
API_BIND_PORT=18088
PUBLIC_API_BASE_URL=http://192.168.50.28:18088
MINIPROGRAM_APP_ID=replace-with-existing-miniprogram-app-id
POSTGRES_DB=blacklight
POSTGRES_ADMIN_USER=blacklight_admin
