# This file contains deployment metadata only. Never put secret values here.
# Secret mounts below always resolve to the existing stage secrets directory.
NAS_DATA_ROOT=/vol1/docker/blacklight-nas-stage
NAS_PRIVATE_NETWORK=blacklight-nas-stage-private

# Keep the website and Mini Program API on separate hosts. Browser API/media
# calls remain same-origin at the website host.
WEB_PUBLIC_ORIGIN=https://shudong.muwei.xyz
WEB_BIND_IP=192.168.50.28
WEB_API_PORT=18120
UNIFIED_WEB_IMAGE=blacklight-unified-web-api:replace-with-full-git-sha
WEB_REGISTRATION=open

# Reuse the current website edge network and its current proxy trust setting.
WEB_EDGE_NETWORK=blacklight-web_edge
WEB_TRUSTED_PROXY_IPS=127.0.0.1
