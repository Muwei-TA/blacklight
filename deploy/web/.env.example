# Copy to deploy/web/.env; never commit real values.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_APP_PASSWORD=replace-with-a-different-random-password
PUBLIC_API_BASE_URL=https://club.example.com
ANON_ALIAS_SECRET=replace-with-at-least-32-random-bytes
MEDIA_URL_SECRET=replace-with-at-least-32-random-bytes
WEB_REGISTRATION=open
# Only bind loopback; terminate HTTPS using your reverse proxy.
WEB_BIND_IP=127.0.0.1
WEB_PORT=3000
# Exact Docker gateway seen as the peer of the host HTTPS proxy.
# Change all three together if this subnet conflicts with your network.
WEB_NETWORK_SUBNET=172.28.42.0/24
WEB_PROXY_GATEWAY=172.28.42.1
WEB_TRUSTED_PROXY_IPS=172.28.42.1
