// 复制为 .env 并填入真实值。.env 已在 .gitignore 中忽略，绝不提交。

# CloudBase 环境 ID
TCB_ENV_ID=

# 匿名别名派生密钥（至少 32 字节随机串）
# 缺失时匿名发布会直接抛错 —— 这是预期的 fail-closed 行为，不要用默认值绕过
ANON_ALIAS_SECRET=

# 内容安全回调共享密钥（仅 HTTP 触发场景需要）
REVIEW_CALLBACK_SECRET=

# PostgreSQL backend credential; server-only secret configuration, never frontend.
# Development credential provisioned 2026-09-22 expires 2026-10-22; rotate before expiry.
CLOUDBASE_APIKEY=

# Stable mini-program AppID for timer-triggered content security APIs.
MINIPROGRAM_APP_ID=wx39773ed34aa30776
