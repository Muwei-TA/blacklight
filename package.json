{
  "name": "heiguang-shudong-backend",
  "version": "0.1.0",
  "private": true,
  "description": "黑光文学社·树洞本地后端（NAS Node.js API + PostgreSQL + 私有媒体存储）",
  "scripts": {
    "sync": "node scripts/sync-shared.mjs",
    "check": "node scripts/check.mjs",
    "build:web-editor": "esbuild web/editor-runtime.mjs --bundle --format=esm --target=es2020 --minify --legal-comments=none --outfile=web/editor.bundle.mjs",
    "pretest": "npm run sync",
    "test": "node --test tests/*.test.mjs",
    "db:init": "node scripts/db-init.mjs",
    "deploy": "node scripts/deploy.mjs",
    "lint": "npx eslint . --ext .js,.mjs --ignore-pattern web/editor.bundle.mjs",
    "start": "node server/index.js",
    "worker": "node server/worker.js",
    "dev:start": "node scripts/sync-shared.mjs && node server/index.js",
    "dev:worker": "node scripts/sync-shared.mjs && node server/worker.js"
  },
  "keywords": [
    "wechat",
    "miniprogram",
    "postgresql",
    "backend"
  ],
  "license": "MIT",
  "devDependencies": {
    "@tiptap/core": "2.27.3",
    "@tiptap/extension-link": "2.27.3",
    "@tiptap/extension-placeholder": "2.27.3",
    "@tiptap/starter-kit": "2.27.3",
    "esbuild": "0.24.2",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.2.5"
  },
  "dependencies": {
    "jpeg-js": "0.4.4",
    "pg": "^8.23.0",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
